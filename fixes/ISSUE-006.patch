+def test_issue_006_quoted_name_with_comma(tmp_path):
+    """load_products must handle a product name that contains a comma (quoted CSV field)."""
+    f = tmp_path / "catalog.csv"
+    f.write_text(
+        'sku,name,price,category\nD100,"Cable, USB-C to USB-C (2m)",12.99,accessories\n',
+        encoding="utf-8",
+    )
+    products = load_products(f)
+    assert len(products) == 1
+    from decimal import Decimal
+    assert products[0].sku == "D100"
+    assert products[0].price == Decimal("12.99")
+    assert "Cable" in products[0].name and "USB-C" in products[0].name
