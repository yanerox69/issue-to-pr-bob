@@ -0,0 +1,24 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from shopcart.discounts import Coupon, total_discount
+
+FUTURE = date(9999, 12, 31)
+
+
+def test_issue_003_stacked_coupons_capped_at_50_percent():
+    """Two 40% coupons on a $100 order must never give more than $50 off."""
+    student40 = Coupon(code="STUDENT40", percent=Decimal("40"), expires=FUTURE)
+    blackfriday40 = Coupon(code="BLACKFRIDAY40", percent=Decimal("40"), expires=FUTURE)
+
+    discount = total_discount(
+        subtotal=Decimal("100"),
+        coupons=[student40, blackfriday40],
+        today=date(2025, 1, 1),
+    )
+
+    assert discount == Decimal("50"), (
+        f"Expected discount capped at $50.00, got ${discount}"
+    )
