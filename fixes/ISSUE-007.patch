+def test_issue_007_bom_utf8_csv(tmp_path):
+    """Excel 'Save As → CSV UTF-8' prepends a UTF-8 BOM (U+FEFF).
+    load_products() must handle it and return the correct sku, not raise KeyError."""
+    f = tmp_path / "excel_export.csv"
+    # Write raw bytes: UTF-8 BOM followed by normal CSV content
+    f.write_bytes(
+        "\ufeffsku,name,price,category\nA1,Widget,9.99,tools\n".encode("utf-8")
+    )
+    products = load_products(f)
+    assert products[0].sku == "A1"
