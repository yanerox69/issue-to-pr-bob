+def test_issue_004_concurrent_reservation_race():
+    """Two orders of 3 units each against 5 in stock: second must raise OutOfStock.
+
+    The race: reserve() checks against raw _stock instead of available(),
+    so both reads see 5 >= 3 before either write lands. This test exploits that
+    window sequentially — first reserve succeeds, second must fail because only
+    2 units remain available.
+    """
+    inv = Inventory()
+    inv.restock("C100", 5)
+
+    # First order reserves 3 — must succeed.
+    inv.reserve("C100", 3)
+
+    # Second order also asks for 3, but only 2 units are still available.
+    with pytest.raises(OutOfStock):
+        inv.reserve("C100", 3)
