+from datetime import date
+from decimal import Decimal
+
+from shopcart.discounts import Coupon, is_valid
+
+
+def test_issue_002_coupon_valid_on_expiry_date():
+    """A coupon whose expires == today must be accepted (it is the last valid day)."""
+    today = date(2024, 9, 30)
+    coupon = Coupon("FALL20", Decimal("20"), expires=today)
+    assert is_valid(coupon, today), (
+        f"Coupon expiring on {today} should be valid when used on {today}"
+    )
