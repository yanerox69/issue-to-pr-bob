+def test_issue_005_reorder_does_not_mutate_original_order(inventory, mouse):
+    """Reordering and then adding items to the new cart must not mutate the
+    past order's item list (shared LineItem reference bug)."""
+    book = OrderBook(inventory)
+    cart = Cart("c1")
+    cart.add(mouse, 2)
+    order = book.place(cart, "CA", today=MONDAY)
+
+    # Snapshot the original order quantity before reorder
+    original_qty = order.items[0].quantity  # should be 2
+
+    # Buy again → new cart pre-filled with 2 × Wireless Mouse
+    new_cart = book.reorder(order.id)
+
+    # Add one more mouse to the *new* cart (now 3 in new cart)
+    new_cart.add(mouse, 1)
+
+    # The original order must still show 2, not 3
+    assert order.items[0].quantity == original_qty, (
+        f"Original order was mutated: expected quantity {original_qty}, "
+        f"got {order.items[0].quantity}"
+    )
