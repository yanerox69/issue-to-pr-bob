+def test_order_id_not_reused_after_cancellation(inventory, mouse, keyboard):
+    """Regression test for ISSUE-010.
+
+    When a cancelled order is removed from the book, the next order must NOT
+    receive an ID that was already issued — even if that ID slot appears free
+    because len(_orders) has shrunk back down.
+
+    Sequence:
+      1. Customer A places order → ORD-00001
+      2. Customer B places order → ORD-00002
+      3. Customer A cancels ORD-00001
+      4. Customer C places order → must NOT be ORD-00002 (collision with B's order)
+    """
+    book = OrderBook(inventory)
+
+    cart_a = Cart("customer-A")
+    cart_a.add(mouse, 1)
+    order_a = book.place(cart_a, "CA", today=MONDAY)
+    assert order_a.id == "ORD-00001"
+
+    cart_b = Cart("customer-B")
+    cart_b.add(keyboard, 1)
+    order_b = book.place(cart_b, "CA", today=MONDAY)
+    assert order_b.id == "ORD-00002"
+
+    book.cancel(order_a.id)
+
+    cart_c = Cart("customer-C")
+    cart_c.add(mouse, 1)
+    order_c = book.place(cart_c, "CA", today=MONDAY)
+
+    # B's order must still be retrievable and untouched
+    assert book.get(order_b.id) is order_b, (
+        f"Customer B's order ({order_b.id}) was overwritten by Customer C's order"
+    )
+
+    # C must receive a brand-new, never-before-issued ID
+    assert order_c.id != order_b.id, (
+        f"ID collision: Customer C received '{order_c.id}', "
+        f"which was already issued to Customer B"
+    )
