         estimated_delivery(date(2026, 9, 21), "teleport")
+
+
+# Regression test for ISSUE-008:
+# Express orders placed on Friday must skip both Saturday AND Sunday.
+# 2026-09-25 is Friday. Adding 2 business days should land on Tuesday 2026-09-29
+# (Mon = day 1, Tue = day 2).  The buggy code counts Saturday as a business day
+# and returns 2026-09-28 (Monday), which is one day too early.
+def test_express_delivery_placed_on_friday_skips_full_weekend():
+    friday = date(2026, 9, 25)
+    expected = date(2026, 9, 29)  # Tuesday
+    assert estimated_delivery(friday, "express") == expected
